void opcontrol() {
	
	
    bool frontWingsReset = true;
    bool frontWingsValue = false;
    bool backWingsReset = true;
    bool backWingsValue = false;
    bool hangReset = true;
    bool hangValue = false;

    char drivingMode = 'T';
    int yButtonCounter = 0;
    

    left_mtrs.set_brake_modes(pros::E_MOTOR_BRAKE_COAST);
    right_mtrs.set_brake_modes(pros::E_MOTOR_BRAKE_COAST);
  
	while (true) {



        //======> Driving <=======
        if (master.get_digital(pros::E_CONTROLLER_DIGITAL_Y)){
            yButtonCounter = yButtonCounter + 1;
        }
        else{
            yButtonCounter = 0;
        }
        if (yButtonCounter > 20){
            if (drivingMode == 'T'){
                drivingMode = 'A';
            }
            else if (drivingMode == 'A'){
                drivingMode = 'T';
            }
        }



        if (drivingMode == 'T'){
            int leftmotorspwr = master.get_analog(ANALOG_LEFT_Y);
            int rightmotorspwr = master.get_analog(ANALOG_RIGHT_Y);
            
            
            if (leftmotorspwr > 10 or leftmotorspwr < -10){
                left_mtrs.move(leftmotorspwr);
            }
            else{
                left_mtrs.move(0);
            }
            if (rightmotorspwr > 10 or rightmotorspwr < -10){
                right_mtrs.move(rightmotorspwr);
            }
            else{
                right_mtrs.move(0);
            }
        }

        else if (drivingMode == 'A'){
            float v;
            if (master.get_analog(ANALOG_RIGHT_X) > 0){
                v = -pow(10000-pow(master.get_analog(ANALOG_RIGHT_X)*100.0/127.5, 2), 0.5)+100;
            }
            else {
                v = pow(10000-pow(master.get_analog(ANALOG_RIGHT_X)*100.0/127.5, 2), 0.5)-100;
            }
            
            
            int leftmotorspwr = master.get_analog(ANALOG_LEFT_Y) + v;
            int rightmotorspwr = master.get_analog(ANALOG_LEFT_Y) - v;
            if (leftmotorspwr == 0){
                left_mtrs.brake();
            }
            else{
                left_mtrs.move(leftmotorspwr);
            }
            if (rightmotorspwr == 0){
                right_mtrs.brake();
            }
            else{
                right_mtrs.move(rightmotorspwr);
            }
        }

        //======> Not Shifting <======
        if ( not master.get_digital(DIGITAL_R2)) {
            
            if (master.get_digital(DIGITAL_L1)) {
                intake.move_voltage(12000);
            }
            else if (master.get_digital(DIGITAL_L2)) {
                intake.move_voltage(-12000);
            }
            else {
                intake.move_voltage(0);
            }
            
        }

        //======> Shifting <======
        else{
            
            if ((master.get_digital(DIGITAL_L1)) and frontWingsReset){
                if (frontWingsValue){
                    rfrontwing.set_value(false);
                    lfrontwing.set_value(false);
                    frontWingsValue = false;
                }
                else if (not frontWingsValue and frontWingsReset){
                    rfrontwing.set_value(true);
                    lfrontwing.set_value(true);
                    frontWingsValue = true;
                }

                frontWingsReset = false;
            }
            

            if ((master.get_digital(DIGITAL_L2)) and backWingsReset){
                if (backWingsValue){
                   sweepWing.set_value(false);
                    backWingsValue = false;
                }
                else if (not backWingsValue and backWingsReset){
                    sweepWing.set_value(true);
                    backWingsValue = true;
                }

                backWingsReset = false;
            }

            if ((master.get_digital(DIGITAL_UP)) and hangReset){
                if (hangValue){
                    hang.set_value(false);
                    hangValue = false;
                }
                else if (not hangValue and hangReset){
                    hang.set_value(true);
                    hangValue = true;
                }

                hangReset = false;
            }
            
        }
        


        if (not master.get_digital(DIGITAL_L1)){
                
                frontWingsReset = true;
        }
        if (not master.get_digital(DIGITAL_L2)){
                
                backWingsReset = true;
        }
        if (not master.get_digital(DIGITAL_UP)){
                
                hangReset = true;
        }
		pros::delay(20);
	}
    

}
