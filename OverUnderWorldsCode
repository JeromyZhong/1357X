void screen() {
    // loop forever
    while (true) {
         // get the current position of the robot
        pros::lcd::print(0, "x: %f", chassis.getPose().x); // print the x position
        pros::lcd::print(1, "y: %f", chassis.getPose().y); // print the y position
        pros::lcd::print(2, "heading: %f", chassis.getPose().theta); // print the heading
        pros::lcd::print(3, "cataLimitValue: %f", fmt::to_string((distance_sensor.get())));
        pros::delay(50);
    }
}
void swingChain(float left1, float right1, float time1){
    right_mtrs.move_velocity(right1);
    left_mtrs.move_velocity(left1);
    
    pros::delay(time1);
}
