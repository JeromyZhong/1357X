    left_mtrs.brake();
    right_mtrs.brake();
    chassis.setPose(-63, -33, 180); //sets pose (side of goal)
    chassis.moveToPoint(-53, -53, 2400, true, 127, false); //Moves parallel to matchloader, next to ball
    sweepWing.set_value(true); //deploys sweepwing
    pros::delay(300);
    //chassis.turnTo(-48, 0, 900, true, 354, false); //Sweeps out ball by turning towards origin
    left_mtrs.move_voltage(-12000);
    right_mtrs.move_voltage(12000);
